apiVersion: v1
kind: Service
metadata: {name: flower, namespace: {{ ops_namespace }}}
spec:
  selector: {app.kubernetes.io/name: flower}
  ports: [{name: http, port: {{ flower_port }}, targetPort: http}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: flower, namespace: {{ ops_namespace }}}
spec:
  replicas: 1
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: flower}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: flower, sunmoonai.com/rabbitmq-client: 'true'}
      annotations: {sunmoonai.com/input-sha256: '{{ flower_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      enableServiceLinks: false
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: flower
          image: {{ registry_address }}/platform/flower@{{ image_map.flower.manifest_digest }}
          imagePullPolicy: IfNotPresent
          args: ['--port={{ flower_port }}', '--address=0.0.0.0']
          envFrom: [{secretRef: {name: flower-auth}}]
          ports: [{name: http, containerPort: {{ flower_port }}}]
          startupProbe: {tcpSocket: {port: http}, periodSeconds: 5, failureThreshold: 60}
          readinessProbe: {tcpSocket: {port: http}, periodSeconds: 10, timeoutSeconds: 3}
          livenessProbe: {tcpSocket: {port: http}, periodSeconds: 20, timeoutSeconds: 3}
          resources: {{ flower_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts: [{name: tmp, mountPath: /tmp}]
      volumes: [{name: tmp, emptyDir: {sizeLimit: 32Mi}}]
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: flower
  namespace: {{ ops_namespace }}
  annotations: {kubernetes.io/ingress.class: sunmoon}
spec:
  entryPoints: [websecure]
  routes:
    - kind: Rule
      match: 'Host(`{{ flower_origin | urlsplit("hostname") }}`)'
      services: [{name: flower, port: http, scheme: http}]
  tls: {secretName: flower-tls}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: flower-ingress, namespace: {{ ops_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: flower}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ ingress_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: traefik}}
      ports: [{protocol: TCP, port: {{ flower_port }}}]
