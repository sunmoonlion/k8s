[Unit]
Description=SunMoon owned KIND cluster {{ cluster_name }}
Requires=docker.service
After=docker.service sunmoon-registry.service sunmoon-entry.service
PartOf=docker.service sunmoon-platform.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre={{ host_runtime_dir }}/check-nodes.sh before
ExecStart=/usr/bin/docker start {{ cluster_name }}-control-plane {{ cluster_name }}-worker {{ cluster_name }}-worker2
ExecStartPost={{ host_runtime_dir }}/kubectl --kubeconfig={{ cluster_kubeconfig }} --context=kind-{{ cluster_name }} --request-timeout=30s wait --for=condition=Ready nodes --all --timeout=300s
ExecStartPost={{ host_runtime_dir }}/check-nodes.sh after
ExecStop={{ host_runtime_dir }}/check-nodes.sh stop
ExecStop=/usr/bin/docker stop --time 60 {{ cluster_name }}-worker2 {{ cluster_name }}-worker {{ cluster_name }}-control-plane
TimeoutStartSec=360
TimeoutStopSec=210
