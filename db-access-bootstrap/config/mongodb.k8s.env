SERVICE_NAME=auth-app-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=mongodb

# In-cluster MongoDB service (override as needed)
DB_HOST=mongodb-sunmoonai.data-platform-dev.svc.cluster.local
DB_PORT=27017

MONGO_ADMIN_USER=root
MONGO_ADMIN_PASSWORD=change_me
MONGO_AUTH_DB=admin
DB_TLS_ENABLED=false

APP_DB_NAME=authdb
APP_DB_USER=auth
APP_DB_PASSWORD=change_me

OUTPUT_NAMESPACE=auth-app
OUTPUT_SECRET_NAME=auth-app-backend-mongodb-conn

DB_PRECHECK_ENABLED=true
DB_PRECHECK_TIMEOUT_SECONDS=60
DB_PRECHECK_INTERVAL_SECONDS=3
K8S_PRECHECK_ENABLED=true
K8S_PRECHECK_NAMESPACE=data-platform-dev
K8S_PRECHECK_LABEL_SELECTOR=app.kubernetes.io/name=mongodb,app.kubernetes.io/instance=mongodb-sunmoonai
