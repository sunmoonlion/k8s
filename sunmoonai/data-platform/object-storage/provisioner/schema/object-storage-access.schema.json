{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunmoonai.com/schemas/object-storage-access.schema.json",
  "title": "SunmoonAI Object Storage Access",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "storage.sunmoonai.com/v1alpha1"
    },
    "kind": {
      "const": "ObjectStorageAccess"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "environment",
        "app",
        "backend",
        "namespace",
        "secretName",
        "configMapName",
        "buckets"
      ],
      "properties": {
        "provider": {
          "const": "platform-s3"
        },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "app": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 40
        },
        "backend": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "secretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "configMapName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "region": {
          "type": "string",
          "default": "us-east-1"
        },
        "forcePathStyle": {
          "type": "boolean",
          "default": true
        },
        "useTLS": {
          "type": "boolean",
          "default": false
        },
        "deletionPolicy": {
          "type": "string",
          "enum": ["Retain"],
          "default": "Retain"
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "permissions"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
                "minLength": 3,
                "maxLength": 63
              },
              "permissions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["read", "write", "delete", "list"]
                }
              },
              "versioning": {
                "type": "boolean",
                "default": false
              },
              "objectLock": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
