apiVersion: v1
kind: Service
metadata: {name: kibana, namespace: {{ data_namespace }}}
spec:
  selector: {app.kubernetes.io/name: kibana}
  ports: [{name: https, port: {{ kibana_port }}, targetPort: https}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: kibana, namespace: {{ data_namespace }}}
spec:
  serviceName: kibana
  replicas: 1
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: kibana}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: kibana, sunmoonai.com/elasticsearch-client: 'true'}
      annotations: {sunmoonai.com/input-sha256: '{{ kibana_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/hostname: '{{ cluster_name }}-{{ kibana_volume.node }}'}
      securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: kibana
          image: {{ registry_address }}/platform/kibana@{{ image_map.kibana.manifest_digest }}
          command: [/bin/tini, --, /usr/share/kibana/bin/kibana]
          args: [--config, /run/auth/kibana.yml]
          env: [{name: NODE_OPTIONS, value: '--max-old-space-size=1024'}]
          ports: [{name: https, containerPort: {{ kibana_port }}}]
          startupProbe: {httpGet: {path: /api/status, port: https, scheme: HTTPS}, periodSeconds: 5, timeoutSeconds: 5, failureThreshold: 120}
          readinessProbe: {httpGet: {path: /api/status, port: https, scheme: HTTPS}, periodSeconds: 10, timeoutSeconds: 5}
          livenessProbe: {tcpSocket: {port: https}, periodSeconds: 30, failureThreshold: 5}
          resources: {{ kibana_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: data, mountPath: /usr/share/kibana/data}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: kibana-data}}
        - {name: auth, secret: {secretName: kibana-auth, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 256Mi}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: kibana-management, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: kibana}}
  policyTypes: [Ingress]
  ingress: []
