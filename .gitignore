
# Helm chart files (build artifacts)
# Helm generated files are not usually needed in the repository
/charts/*.tgz
/charts/Chart.lock
/charts/values.yaml

# Helm chart dependencies (if you manage them separately)
# If you're packaging charts with Helm, these shouldn't be in the repository
/charts/requirements.lock

# Environment variables (sensitive information like API keys and secrets)
*.env
.env.local
.env.*.local

# Kubernetes Secrets and certificates (they should not be in the repository)
# Avoid tracking sensitive information like .pem, .key, .crt, and secret files
/secrets/*
*.pem
*.key
*.crt
*.pfx
*.jks
*.csr

# Kind 脚本生成的临时配置（create-kind-cluster.sh）
.kind-cluster-generated.yaml

# Log files
# Ignore logs generated by the application, especially in containers or CI/CD pipelines
*.log
/logs/
/var/log/

/build/
/dist/
/tmp/

# Docker-related files
# Ignore Docker build artifacts like the Docker image cache, and build contexts
.docker/
.dockerignore
Dockerfile.*

# Node.js files
# Ignore node_modules (dependency directories) and package-lock.json (lock file for npm/yarn)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Build output directories
# Ignore build files like Java .class files, .obj files, etc.
build/
/out/
/target/

# Compiled files
*.o
*.a
*.so
*.dll
*.exe
*.dmg
*.apk

# macOS specific files
# macOS automatically generates these files which are not needed in repositories
.DS_Store
.AppleDouble
.LSOverride

# Windows specific files
Thumbs.db
ehthumbs.db

# IntelliJ IDE files (IDE specific project files)
.idea/
*.iml

# Visual Studio Code workspace settings
.vscode/

# JetBrains IDEs
.idea/

# Temporary editor files
*.swp
*.swo
*~

# CI/CD files (if not needed in version control)
# Ignore CI/CD related directories or files for tools like Jenkins, GitLab CI, CircleCI, etc.
.circleci/
.github/
.gitlab-ci.yml
Jenkinsfile

# Virtual environments (Python/Node etc.)
# Ignore virtual environment directories created by Python (venv, pyenv) or Node.js
.env/
.venv/
node_modules/
*.pnp.js

# Python related
__pycache__/
*.pyc
*.pyo
*.pyd

# Ruby related
*.gem
*.rbc
.bundle/
/vendor/
*.log
*.tmp

# Terraform files
# Ignore terraform files related to state, plan, etc.
*.tfstate
*.tfstate.*
.terraform/

# Ansible related files
# Ignore Ansible dynamic inventories or cache files
*.retry
*.log
host_vars/
group_vars/

# Cloud Infrastructure files
# Ignore cloud provider SDK configuration files and credentials
.aws/
.azure/
.gcp/
.credentials/

# SQL Dump files (databases)
*.sql
*.sql.gz
*.bak

# Temporary files
# Ignore temporary files created by applications, including those used during deployment
tmp/
*.bak
*.swp

# Python Wheel files (compiled Python packages)
*.whl

# Go-related build files
*.out
*.exe
*.exe~
*.test
*.log

# Test-related files (including coverage reports)
*.coverage
*.tox/
*.nox/
*.coverage.*
nosetests.xml
coverage.xml
*.log

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Maven build files
target/
*.log

# Gradle build files
.gradle/
build/
*.log

# 例外：不忽略 app-platform 下各组件的 build 目录
# 具体忽略规则由各 build/.gitignore 文件控制
!sunmoonai/app-platform/*/build/

# Kind 离线镜像 tar 包（不适合进 Git，体积大且可重新生成）
sunmoonai/kind-infrastructure/deploy-kind/images-init-dir/

# 外部 Harbor 运行时目录（docker-compose 生成的配置和数据，仅用于本机运行和调试，不纳入版本控制）
utils/HARBOR-KIND-EXTERNAL/harbor-runtime/
