# 结构示例，请勿直接 apply。各集群/环境请复制为 mongo-express-secrets.yaml 并填写 base64 编码后的值。
apiVersion: v1
kind: Secret
metadata:
  name: mongo-express-secrets
  namespace: ops-platform-dev
type: Opaque
data:
  basic-auth-password: ""
  mongo-express-admin-user: ""
  mongo-express-password: ""
  mongodb-auth-password: ""
  site-cookie-secret: ""
  site-session-secret: ""
