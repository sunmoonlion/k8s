{
  "apiVersion": "search.sunmoonai.com/v1alpha1",
  "kind": "ElasticsearchAccess",
  "metadata": {
    "name": "example-admin-backend"
  },
  "spec": {
    "provider": "platform-elasticsearch",
    "environment": "development",
    "app": "example-app",
    "backend": "admin-backend",
    "namespace": "app-platform-dev",
    "secretName": "example-admin-backend-elasticsearch",
    "configMapName": "example-admin-backend-elasticsearch",
    "datasets": [
      {
        "name": "documents",
        "schemaVersion": 1,
        "permissions": ["read", "write"],
        "settings": {
          "analysis": {
            "analyzer": {
              "default": {
                "type": "standard"
              }
            }
          }
        },
        "mappings": {
          "dynamic": "strict",
          "properties": {
            "document_id": {
              "type": "keyword"
            },
            "title": {
              "type": "text"
            },
            "content": {
              "type": "text"
            },
            "updated_at": {
              "type": "date"
            }
          }
        }
      }
    ]
  }
}
