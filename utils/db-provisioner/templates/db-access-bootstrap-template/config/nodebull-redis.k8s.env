SERVICE_NAME=investment-web-backend-nodebull
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=redis

# NodeBull/Bull queues use a dedicated Redis instance, not the session/cache Redis.
DB_HOST=redis-nodebull-master.data-platform-dev.svc.cluster.local
DB_PORT=6379
APP_DB_NAME=0
APP_DB_USER=investment_web_nodebull
APP_DB_PASSWORD=InvestmentWebNodeBullRedisAcl_9pQ4vM2xL8nR6sK3

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=Re!d1359admin
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
REDIS_KEY_PREFIX="bull:investment:web:*"
REDIS_ACL_CATEGORY="+@read +@write +@connection +@hash +@string +@list +@set +@sortedset +@pubsub"
# Bull psubscribe 模式无法被 &key:* 前缀完全覆盖，专用 nodebull Redis 使用 allchannels
REDIS_ALL_CHANNELS=true

QUEUE_REDIS_PREFIX=bull:investment:web
OUTPUT_ENV_PREFIX=QUEUE_REDIS

# Set this to the namespace where nodebullworker-investment-web-backend runs.
OUTPUT_NAMESPACE=app-platform-dev
OUTPUT_SECRET_NAME=investment-web-backend-nodebull-redis-conn
