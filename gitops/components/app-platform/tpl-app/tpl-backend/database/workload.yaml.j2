apiVersion: v1
kind: ServiceAccount
metadata: {name: tpl-runtime, namespace: {{ cfg.namespace }}}
automountServiceAccountToken: false
imagePullSecrets: [{name: registry-puller}]
---
apiVersion: batch/v1
kind: Job
metadata: {name: 'tpl-database-{{ cfg.database_bootstrap_revision }}', namespace: {{ data_namespace }}}
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels: {app.kubernetes.io/part-of: tpl, sunmoonai.com/postgresql-client: 'true'}
    spec:
      restartPolicy: Never
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 999, runAsGroup: 999, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: provision
          image: {{ registry_address }}/platform/postgresql@{{ image_map.postgresql.manifest_digest }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: '1', memory: 256Mi}}
          env:
            - {name: PGHOST, value: 'postgresql.{{ data_namespace }}.svc.cluster.local'}
            - {name: PGUSER, value: postgres}
            - {name: PGDATABASE, value: postgres}
            - {name: PGCONNECT_TIMEOUT, value: '10'}
            - {name: PGPASSWORD, valueFrom: {secretKeyRef: {name: postgresql-auth, key: password}}}
            - {name: MIGRATOR_PASSWORD, valueFrom: {secretKeyRef: {name: tpl-database-bootstrap, key: migrator_password}}}
            - {name: RUNTIME_PASSWORD, valueFrom: {secretKeyRef: {name: tpl-database-bootstrap, key: runtime_password}}}
          command: [/bin/sh, -ec]
          args:
            - |
              psql --no-psqlrc --set=ON_ERROR_STOP=1 <<'SQL'
              \set VERBOSITY terse
              \getenv migrator_password MIGRATOR_PASSWORD
              \getenv runtime_password RUNTIME_PASSWORD
              SELECT pg_advisory_lock(hashtextextended('sunmoon/tpl/database',0));
              DO $bootstrap$ BEGIN
                IF EXISTS (SELECT FROM pg_roles WHERE rolname IN ('{{ cfg.database_runtime_user }}','{{ cfg.database_migrator_user }}') AND shobj_description(oid,'pg_authid') IS DISTINCT FROM 'sunmoon-kind/tpl') THEN
                  RAISE EXCEPTION 'Refusing a foreign existing role';
                END IF;
                IF EXISTS (SELECT FROM pg_database WHERE datname='{{ cfg.database }}' AND shobj_description(oid,'pg_database') IS DISTINCT FROM 'sunmoon-kind/tpl') THEN
                  RAISE EXCEPTION 'Refusing a foreign existing database';
                END IF;
              END $bootstrap$;
              SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L','{{ cfg.database_migrator_user }}',:'migrator_password') WHERE NOT EXISTS(SELECT FROM pg_roles WHERE rolname='{{ cfg.database_migrator_user }}') \gexec
              SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L','{{ cfg.database_runtime_user }}',:'runtime_password') WHERE NOT EXISTS(SELECT FROM pg_roles WHERE rolname='{{ cfg.database_runtime_user }}') \gexec
              COMMENT ON ROLE {{ cfg.database_migrator_user }} IS 'sunmoon-kind/tpl';
              COMMENT ON ROLE {{ cfg.database_runtime_user }} IS 'sunmoon-kind/tpl';
              SELECT format('CREATE DATABASE %I OWNER %I','{{ cfg.database }}','{{ cfg.database_migrator_user }}') WHERE NOT EXISTS(SELECT FROM pg_database WHERE datname='{{ cfg.database }}') \gexec
              COMMENT ON DATABASE {{ cfg.database }} IS 'sunmoon-kind/tpl';
              REVOKE ALL ON DATABASE {{ cfg.database }} FROM PUBLIC;
              GRANT CONNECT ON DATABASE {{ cfg.database }} TO {{ cfg.database_runtime_user }};
              SQL
              PGPASSWORD="$MIGRATOR_PASSWORD" psql --no-psqlrc -U {{ cfg.database_migrator_user }} -d {{ cfg.database }} --set=ON_ERROR_STOP=1 <<'SQL'
              REVOKE CREATE ON SCHEMA public FROM PUBLIC;
              GRANT USAGE ON SCHEMA public TO {{ cfg.database_runtime_user }};
              ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT,INSERT,UPDATE,DELETE ON TABLES TO {{ cfg.database_runtime_user }};
              ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE,SELECT ON SEQUENCES TO {{ cfg.database_runtime_user }};
              SQL
              PGPASSWORD="$RUNTIME_PASSWORD" psql --no-psqlrc -U {{ cfg.database_runtime_user }} -d {{ cfg.database }} --set=ON_ERROR_STOP=1 -c 'SELECT 1' >/dev/null
              echo 'TPL independent database identities verified'
