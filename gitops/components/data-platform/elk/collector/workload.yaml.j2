apiVersion: v1
kind: Namespace
metadata:
  name: {{ elk_collector_namespace }}
  labels:
    # hostPath is forbidden even under baseline; exemption confined to this namespace.
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/audit-version: v1.36
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: log-collector, namespace: {{ elk_collector_namespace }}}
automountServiceAccountToken: false
imagePullSecrets: [{name: registry-puller}]
---
apiVersion: v1
kind: ConfigMap
metadata: {name: log-collector-settings, namespace: {{ elk_collector_namespace }}}
data:
  fluent-bit.conf: |
    [SERVICE]
        Flush 2
        Grace 30
        Log_Level warn
        Parsers_File /fluent-bit/etc/parsers.conf
        HTTP_Server On
        HTTP_Listen 0.0.0.0
        HTTP_Port 2020
        Health_Check On
        storage.path /state/chunks
        storage.sync full
        storage.checksum on
        storage.max_chunks_up {{ elk_collector_memory_chunks }}
        storage.pause_on_chunks_overlimit on
    [INPUT]
        Name tail
        Path {% for app in elk_collector_applications %}/var/log/containers/{{ app }}*_{{ app_namespace }}_*.log{{ ',' if not loop.last else '' }}{% endfor %}

        Tag kube.*
        multiline.parser cri
        DB /state/tail.db
        DB.sync full
        DB.locking true
        DB.compare_filename true
        Path_Key log_file
        Read_from_Head {{ 'On' if elk_collector_read_from_head | bool else 'Off' }}
        Refresh_Interval 5
        Rotate_Wait 30
        Buffer_Max_Size 1M
        Skip_Long_Lines Off
        storage.type filesystem
    [FILTER]
        Name kubernetes
        Match kube.*
        Kube_Tag_Prefix kube.var.log.containers.
        Use_Tag_For_Meta On
        Labels Off
        Annotations Off
        Merge_Log Off
    [FILTER]
        Name modify
        Match kube.*
        Rename log message
        Add cluster {{ cluster_name }}
        Add node ${NODE_NAME}
    [OUTPUT]
        Name http
        Match kube.*
        Host logstash.{{ data_namespace }}.svc.cluster.local
        Port {{ logstash_ingest_port }}
        URI /
        Format json
        Json_date_key @timestamp
        Json_date_format iso8601
        Header Content-Type application/json
        HTTP_User {{ elk_ingest_username }}
        HTTP_Passwd ${INGEST_PASSWORD}
        tls On
        tls.verify On
        tls.verify_hostname On
        tls.ca_file /run/auth/ca.crt
        Retry_Limit no_limits
---
apiVersion: apps/v1
kind: DaemonSet
metadata: {name: log-collector, namespace: {{ elk_collector_namespace }}}
spec:
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: fluent-bit}}
  updateStrategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 1}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: fluent-bit}
      annotations:
        sunmoonai.com/input-sha256: '{{ elk_collector_input_digest }}'
        sunmoonai.com/config-sha256: '{{ [lookup("template", playbook_dir + "/../../gitops/components/data-platform/elk/collector/config-identity.j2"),lookup("file", playbook_dir + "/../../gitops/components/data-platform/elk/collector/workload.yaml.j2")] | to_json | hash("sha256") }}'
    spec:
      serviceAccountName: log-collector
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      nodeSelector: {kubernetes.io/os: linux}
      tolerations:
        - {key: node-role.kubernetes.io/control-plane, operator: Exists, effect: NoSchedule}
      securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 0, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: fluent-bit
          image: {{ registry_address }}/platform/fluent-bit@{{ image_map['fluent-bit'].manifest_digest }}
          args: [-c, /settings/fluent-bit.conf]
          env:
            - {name: NODE_NAME, valueFrom: {fieldRef: {fieldPath: spec.nodeName}}}
            - {name: INGEST_PASSWORD, valueFrom: {secretKeyRef: {name: log-collector-auth, key: password}}}
          ports: [{name: health, containerPort: 2020}]
          readinessProbe: {httpGet: {path: /api/v1/health, port: health}, periodSeconds: 10}
          livenessProbe: {httpGet: {path: /api/v1/health, port: health}, periodSeconds: 30, failureThreshold: 6}
          resources: {{ elk_collector_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: logs, mountPath: /var/log, readOnly: true}
            - {name: state, mountPath: /state}
            - {name: settings, mountPath: /settings, readOnly: true}
            - {name: auth, mountPath: /run/auth, readOnly: true}
      volumes:
        - {name: logs, hostPath: {path: /var/log, type: Directory}}
        - {name: state, hostPath: {path: '{{ elk_collector_state_directory }}', type: Directory}}
        - {name: settings, configMap: {name: log-collector-settings}}
        - {name: auth, secret: {secretName: log-collector-auth, defaultMode: 0440}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: log-collector-bounded, namespace: {{ elk_collector_namespace }}}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
  ingress: []
  egress:
    - to:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}
          podSelector: {matchLabels: {k8s-app: kube-dns}}
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
    - to:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ data_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: logstash}}
      ports: [{protocol: TCP, port: {{ logstash_ingest_port }}}]
