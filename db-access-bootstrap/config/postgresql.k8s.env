SERVICE_NAME=auth-app-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=postgresql

# In-cluster PostgreSQL service (override as needed)
DB_HOST=postgresql-sunmoonai.data-platform-dev.svc.cluster.local
DB_PORT=5432

# Admin credentials (prefer pulling from Secret via your secret system)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=${PG_ADMIN_PASSWORD:-zym123}
PG_ADMIN_DB=postgres
PG_SSLMODE=prefer

# Tenant for this service
APP_DB_NAME=authdb
APP_DB_USER=auth
APP_DB_PASSWORD=${APP_DB_PASSWORD:-authpass}

# Output secret (consumed by your Deployment)
OUTPUT_NAMESPACE=auth-app
OUTPUT_SECRET_NAME=auth-app-backend-postgresql-conn

# Precheck
DB_PRECHECK_ENABLED=true
DB_PRECHECK_TIMEOUT_SECONDS=60
DB_PRECHECK_INTERVAL_SECONDS=3
K8S_PRECHECK_ENABLED=true
K8S_PRECHECK_NAMESPACE=data-platform-dev
K8S_PRECHECK_LABEL_SELECTOR=app.kubernetes.io/name=postgresql,app.kubernetes.io/instance=sunmoonai
