SERVICE_NAME=casdoor
ENVIRONMENT=dev

# Service namespace (for k8s outputs and in-cluster defaults)
NAMESPACE=app-platform-dev

# Which engines to manage for this service
ENABLE_POSTGRESQL=true
ENABLE_REDIS=false
ENABLE_MONGODB=false

# Paths
K8S_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
if [[ -z "${DBCTL_BIN:-}" ]]; then
  DBCTL_BIN="${K8S_ROOT}/utils/db-provisioner/bin/dbctl"
fi

# PostgreSQL 临时 client pod 镜像也必须按集群解析 Harbor 地址。
# dbctl 优先读取 PG_CLIENT_IMAGE。Casdoor provision 默认不继承外层 PG_CLIENT_IMAGE，
# 避免 shell 残留变量把 Kind 错带到远程地址；如确需覆盖，使用 CASDOOR_PG_CLIENT_IMAGE。
if [[ -n "${CASDOOR_PG_CLIENT_IMAGE:-}" ]]; then
  PG_CLIENT_IMAGE="${CASDOOR_PG_CLIENT_IMAGE}"
elif [[ -f "${K8S_ROOT}/utils/cluster-config-mapping.sh" ]]; then
  # shellcheck disable=SC1091
  source "${K8S_ROOT}/utils/cluster-config-mapping.sh"
  PG_CLIENT_IMAGE="$(get_cluster_harbor_registry)/k8s-images/postgresql:17.6.0-debian-12-r4"
else
  PG_CLIENT_IMAGE="harbor.sunmoonai.com/k8s-images/postgresql:17.6.0-debian-12-r4"
fi
export PG_CLIENT_IMAGE

# Casdoor 是第三方 Helm chart，没有本地 .env 模板
# setup-external-db-access.sh 只做 DB provision，不生成 app env 文件
BASE_ENV_TEMPLATE=/dev/null
OUT_ENV=/tmp/casdoor-db.env

# 关闭模板文件检查（Casdoor 无本地源码目录）
STRICT_FILE_CHECK=false
