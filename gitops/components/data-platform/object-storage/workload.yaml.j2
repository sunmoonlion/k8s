apiVersion: v1
kind: Service
metadata: {name: object-storage, namespace: {{ data_namespace }}}
spec:
  selector: {app.kubernetes.io/name: object-storage}
  ports:
    - {name: https, port: {{ object_storage_port }}, targetPort: https}
    - {name: console, port: {{ object_storage_console_port }}, targetPort: console}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: object-storage, namespace: {{ data_namespace }}}
spec:
  serviceName: object-storage
  replicas: {{ 1 if services_object_storage_enabled else 0 }}
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: object-storage}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: object-storage}
      annotations: {sunmoonai.com/input-sha256: '{{ object_storage_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/hostname: '{{ cluster_name }}-{{ object_storage_volume.node }}'}
      terminationGracePeriodSeconds: 60
      securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: object-storage
          image: {{ registry_address }}/platform/aistor@{{ image_map.aistor.manifest_digest }}
          imagePullPolicy: IfNotPresent
          command: [minio]
          args: [server, /data, --address, ':{{ object_storage_port }}', --console-address, ':{{ object_storage_console_port }}', --license, /run/auth/minio.license, --certs-dir, /run/auth]
          env:
            - {name: MINIO_ROOT_USER_FILE, value: /run/auth/root-user}
            - {name: MINIO_ROOT_PASSWORD_FILE, value: /run/auth/root-password}
            - {name: MINIO_SITE_REGION, value: '{{ object_storage_region }}'}
            - {name: HOME, value: /tmp}
{% if object_storage_ui_enabled | bool %}
            - {name: MINIO_BROWSER_REDIRECT_URL, value: '{{ object_storage_ui_origin }}'}
            - {name: MINIO_SERVER_URL, value: 'https://object-storage.{{ data_namespace }}.svc.cluster.local:{{ object_storage_port }}'}
{% endif %}
          ports:
            - {name: https, containerPort: {{ object_storage_port }}}
            - {name: console, containerPort: {{ object_storage_console_port }}}
          startupProbe: {httpGet: {path: /minio/health/live, port: https, scheme: HTTPS}, periodSeconds: 5, failureThreshold: 60}
          readinessProbe: {httpGet: {path: /minio/health/ready, port: https, scheme: HTTPS}, periodSeconds: 10, timeoutSeconds: 3}
          livenessProbe: {httpGet: {path: /minio/health/live, port: https, scheme: HTTPS}, periodSeconds: 20, timeoutSeconds: 3}
          resources: {{ object_storage_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: object-storage-data}}
        - {name: auth, secret: {secretName: object-storage-auth, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
