{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/research/runtime/v1/source-resolution.schema.json",
  "title": "Research Runtime Authorized Source Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["location"],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/api/citation-sources/[0-9a-fA-F-]{36}$"
    }
  }
}
