apiVersion: v1
kind: ConfigMap
metadata: {name: kibana-ui-initialize-{{ kibana_ui_generation }}, namespace: {{ data_namespace }}}
data:
  initialize.js: |
{{ lookup('template', playbook_dir + '/../../gitops/components/data-platform/elk/kibana/ui/initialize.js.j2') | indent(4, true) }}
  tls-client.js: |
{{ lookup('template', playbook_dir + '/../../gitops/components/data-platform/elk/tls-client.js.j2') | indent(4, true) }}
---
apiVersion: batch/v1
kind: Job
metadata: {name: kibana-ui-initialize-{{ kibana_ui_generation }}, namespace: {{ data_namespace }}}
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 180
  template:
    metadata:
      labels: {app.kubernetes.io/name: kibana-ui-initialize, sunmoonai.com/elasticsearch-client: 'true'}
      annotations: {sunmoonai.com/input-sha256: '{{ kibana_ui_identity_digest }}'}
    spec:
      restartPolicy: Never
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: initialize
          image: {{ registry_address }}/platform/kibana@{{ image_map.kibana.manifest_digest }}
          command: [/usr/share/kibana/node/default/bin/node, /scripts/initialize.js]
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: 500m, memory: 256Mi}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: script, mountPath: /scripts, readOnly: true}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: admin, mountPath: /run/admin, readOnly: true}
      volumes:
        - {name: script, configMap: {name: kibana-ui-initialize-{{ kibana_ui_generation }}}}
        - {name: auth, secret: {secretName: kibana-ui-auth, defaultMode: 0440}}
        - {name: admin, secret: {secretName: kibana-ui-admin, defaultMode: 0440}}
---
apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata: {name: kibana-internal, namespace: {{ data_namespace }}}
spec:
  serverName: kibana.{{ data_namespace }}.svc.cluster.local
  rootCAsSecrets: [kibana-upstream-ca]
  insecureSkipVerify: false
  forwardingTimeouts: {dialTimeout: 10s, responseHeaderTimeout: 60s}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: kibana-ui
  namespace: {{ data_namespace }}
  annotations: {kubernetes.io/ingress.class: sunmoon}
spec:
  entryPoints: [websecure]
  routes:
    - kind: Rule
      match: 'Host(`{{ kibana_ui_origin | urlsplit("hostname") }}`)'
      services: [{name: kibana, port: https, scheme: https, serversTransport: kibana-internal}]
  tls: {secretName: kibana-ui-tls}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: kibana-ui-access, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: kibana}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ ingress_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: traefik}}
        - podSelector: {matchLabels: {app.kubernetes.io/name: kibana-ui-initialize}}
      ports: [{protocol: TCP, port: {{ kibana_port }}}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: kibana-ui-initialize-egress, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: kibana-ui-initialize}}
  policyTypes: [Egress]
  egress:
    - to: [{podSelector: {matchLabels: {app.kubernetes.io/name: kibana}}}]
      ports: [{protocol: TCP, port: {{ kibana_port }}}]
