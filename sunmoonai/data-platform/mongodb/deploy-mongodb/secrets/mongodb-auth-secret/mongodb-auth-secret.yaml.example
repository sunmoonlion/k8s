apiVersion: v1
kind: Secret
metadata:
  name: mongodb-auth-secret
  namespace: data-platform-dev
type: Opaque
stringData:
  # Root 用户密码
  mongodb-root-password: "CHANGE_ME_STRONG_ROOT_PASSWORD"
  # 应用用户密码列表（与 values.yaml 中 auth.usernames 顺序一致，多个用英文逗号分隔）
  mongodb-passwords: "CHANGE_ME_STRONG_USER_PASSWORD"
---
# 仅归档/占位用途：实际由统一密管创建与更新；本文件用于结构对齐

