// release 流水线的任务（0033 第四节、第十节）。任务体在仓里 ci/release.groovy；这里只放引导：
// 在代理上把 k8s 仓更新到分支头、load 仓里的脚本，然后在 node 外面调 main——人批那一步不占执行器（第十节 10.2）。
// 只建一次；已存在时只补缺的属性、引导文本变了就更新 definition、参数集合变了就换成模板的（参数是我们的，不是人改的）。
// 不设定时器：发布只由人点（页面「Build with Parameters」或 make jenkins-release-run）。
import jenkins.model.Jenkins
import hudson.model.ParametersDefinitionProperty
import hudson.model.StringParameterDefinition
import hudson.model.ChoiceParameterDefinition
import org.jenkinsci.plugins.workflow.job.WorkflowJob
import org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty
import org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition

def jenkins = Jenkins.get()
def bootstrap = '''
def body
node('{{ jenkins_agent_name }}') {
  dir('{{ jenkins_repos_dir }}/{{ jenkins_root_repo }}') {
    sh 'git fetch -q origin "+refs/heads/*:refs/remotes/origin/*" && git checkout -q --detach "origin/' + params.BRANCH + '"'
    body = load 'ci/release.groovy'
  }
}
body.main(params, '{{ jenkins_repos_dir }}', '{{ jenkins_human_account.username }}', '{{ jenkins_root_repo }}')
'''
def wantedParams = ['BRANCH', 'APPS', 'PIN', 'NOTE', 'APPROVAL_TIMEOUT_MINUTES']
def newParams = {
    new ParametersDefinitionProperty(
        new StringParameterDefinition('BRANCH', '{{ jenkins_render_check_branch }}', 'k8s 与各应用仓都用这个分支'),
        new StringParameterDefinition('APPS', 'tpl', '要发的应用，空格分隔；空 = 全部六个'),
        new ChoiceParameterDefinition('PIN', ['keep', 'heads'] as String[], 'keep = 按已提交的 sources.yaml 钉；heads = 钉到各应用父仓在 BRANCH 的头（子仓取父仓记录的 gitlink）'),
        new StringParameterDefinition('NOTE', '', '一句话，进提交说明、构建说明和回执；不含引号'),
        new StringParameterDefinition('APPROVAL_TIMEOUT_MINUTES', '1440', '第 8 阶段等人批多少分钟，到时中止（默认 24 小时）')
    )
}

def job = jenkins.getItem('release')
if (job == null) {
    job = jenkins.createProject(WorkflowJob, 'release')
    job.setDescription('发布卡：核对 → 改钉 → 构建 → 暂存 → 计划 → 提交 → 发布 → 人批 → 写指针 → 部署 → 检查 → 推送与回执。任务体在 k8s 仓 ci/release.groovy。')
    job.addProperty(newParams())
    job.addProperty(new DisableConcurrentBuildsJobProperty())
    job.setDefinition(new CpsFlowDefinition(bootstrap, true))
    job.save()
} else if (job instanceof WorkflowJob) {
    def changed = false
    if (job.getProperty(DisableConcurrentBuildsJobProperty) == null) {
        job.addProperty(new DisableConcurrentBuildsJobProperty()); changed = true
    }
    def pdp = job.getProperty(ParametersDefinitionProperty)
    if (pdp == null || !pdp.getParameterDefinitionNames().containsAll(wantedParams)) {
        if (pdp != null) { job.removeProperty(pdp) }
        job.addProperty(newParams()); changed = true
    }
    def defn = job.getDefinition()
    if (!(defn instanceof CpsFlowDefinition) || defn.getScript() != bootstrap) {
        job.setDefinition(new CpsFlowDefinition(bootstrap, true)); changed = true
    }
    if (changed) { job.save() }
}
