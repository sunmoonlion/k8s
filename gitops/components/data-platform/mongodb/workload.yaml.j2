apiVersion: v1
kind: Service
metadata: {name: mongodb, namespace: {{ data_namespace }}}
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector: {app.kubernetes.io/name: mongodb}
  ports: [{name: mongodb, port: {{ mongodb_port }}, targetPort: mongodb}]
---
apiVersion: v1
kind: ConfigMap
metadata: {name: mongodb-settings, namespace: {{ data_namespace }}}
data:
  mongod.conf: |
    storage:
      dbPath: /data/db
      wiredTiger:
        engineConfig:
          cacheSizeGB: {{ mongodb_wiredtiger_cache_gib }}
    net:
      bindIpAll: true
      port: {{ mongodb_port }}
      tls:
        mode: requireTLS
        certificateKeyFile: /run/identity/server.pem
        CAFile: /run/auth/ca.crt
        allowConnectionsWithoutCertificates: true
    security:
      authorization: enabled
      keyFile: /run/identity/replica-key
    replication:
      replSetName: {{ mongodb_replica_set }}
      oplogSizeMB: {{ mongodb_oplog_mib }}
{% for script in ['common.js','health.js','initialize.js','verify.js','persistence.js'] %}
  {{ script }}: |
{{ lookup('file',playbook_dir + '/../../gitops/components/data-platform/mongodb/' + script) | indent(4,true) }}
{% endfor %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: mongodb, namespace: {{ data_namespace }}}
spec:
  serviceName: mongodb
  replicas: 1
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: mongodb}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: mongodb}
      annotations: {sunmoonai.com/input-sha256: '{{ mongodb_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      enableServiceLinks: false
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/hostname: '{{ cluster_name }}-{{ mongodb_volume.node }}'}
      terminationGracePeriodSeconds: 120
      securityContext: {runAsNonRoot: true, runAsUser: 999, runAsGroup: 999, fsGroup: 999, seccompProfile: {type: RuntimeDefault}}
      initContainers:
        - name: prepare-identity
          image: {{ registry_address }}/platform/mongodb@{{ image_map.mongodb.manifest_digest }}
          command: [sh, -ec]
          args: ['umask 077; cp /run/auth/server.pem /run/auth/replica-key /run/identity/; chmod 0600 /run/identity/*']
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: '1', memory: 128Mi}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: identity, mountPath: /run/identity}
            - {name: auth, mountPath: /run/auth, readOnly: true}
      containers:
        - name: mongodb
          image: {{ registry_address }}/platform/mongodb@{{ image_map.mongodb.manifest_digest }}
          imagePullPolicy: IfNotPresent
          args: [mongod, --config, /settings/mongod.conf]
          env:
            - {name: MONGO_INITDB_ROOT_USERNAME_FILE, value: /run/auth/root-username}
            - {name: MONGO_INITDB_ROOT_PASSWORD_FILE, value: /run/auth/root-password}
            - {name: MONGODB_HOST, value: 'mongodb.{{ data_namespace }}.svc.cluster.local'}
            - {name: MONGODB_PORT, value: '{{ mongodb_port }}'}
            - {name: MONGODB_REPLICA_SET, value: '{{ mongodb_replica_set }}'}
            - {name: MONGODB_ACCEPTANCE_DATABASE, value: '{{ mongodb_acceptance_database }}'}
            - {name: MONGODB_VERSION, value: '{{ image_map.mongodb.source.rsplit(":",1)[1].split("-")[0] }}'}
          ports: [{name: mongodb, containerPort: {{ mongodb_port }}}]
          startupProbe: {tcpSocket: {port: mongodb}, periodSeconds: 5, failureThreshold: 120, timeoutSeconds: 5}
          readinessProbe: {exec: {command: [mongosh, --quiet, --nodb, --file, /settings/health.js]}, periodSeconds: 30, timeoutSeconds: 10, failureThreshold: 3}
          livenessProbe: {tcpSocket: {port: mongodb}, periodSeconds: 30, timeoutSeconds: 3, failureThreshold: 5}
          resources: {{ mongodb_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: data, mountPath: /data/db}
            - {name: configdb, mountPath: /data/configdb}
            - {name: tmp, mountPath: /tmp}
            - {name: settings, mountPath: /settings, readOnly: true}
            - {name: identity, mountPath: /run/identity, readOnly: true}
            - {name: auth, mountPath: /run/auth, readOnly: true}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: mongodb-data}}
        - {name: configdb, emptyDir: {sizeLimit: 16Mi}}
        - {name: tmp, emptyDir: {sizeLimit: 128Mi}}
        - {name: identity, emptyDir: {medium: Memory, sizeLimit: 4Mi}}
        - {name: settings, configMap: {name: mongodb-settings}}
        - {name: auth, secret: {secretName: mongodb-auth, defaultMode: 0440}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: mongodb-clients, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: mongodb}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app.kubernetes.io/name: mongodb-initialize}}
        - podSelector: {matchLabels: {app.kubernetes.io/name: mongodb}}
      ports: [{protocol: TCP, port: {{ mongodb_port }}}]
  egress:
    - to:
        - podSelector: {matchLabels: {app.kubernetes.io/name: mongodb}}
      ports: [{protocol: TCP, port: {{ mongodb_port }}}]
