{% set name = 'postgresql' %}
{% set port = 5432 %}
{% if services_postgresql_enabled %}
{% set image = image_map[name] %}
{% set volume = services_volumes | selectattr('name','equalto',name) | first %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-headless
  namespace: {{ component_namespaces[name] }}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: {{ name }}}
  ports: [{name: service, port: {{ port }}, targetPort: {{ port }}}]
---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ component_namespaces[name] }}
spec:
  selector: {app.kubernetes.io/name: {{ name }}}
  ports:
    - {name: service, port: {{ port }}, targetPort: {{ port }}}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ name }}
  namespace: {{ component_namespaces[name] }}
spec:
  serviceName: {{ name }}-headless
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: {{ name }}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: {{ name }}, app.kubernetes.io/part-of: sunmoon-platform}
    spec:
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      nodeSelector:
        kubernetes.io/hostname: {{ cluster_name }}-{{ volume.node }}
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ volume.uid }}
        runAsGroup: {{ volume.gid }}
        fsGroup: {{ volume.gid }}
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: {{ name }}
          image: {{ registry_address }}/platform/{{ name }}@{{ image.manifest_digest }}
          imagePullPolicy: IfNotPresent
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources:
            requests: {cpu: 100m, memory: {{ '256Mi' if name != 'redis' else '128Mi' }}}
            limits: {cpu: '2', memory: {{ '1Gi' if name != 'redis' else '512Mi' }}}
          ports:
            - {name: service, containerPort: {{ port }}}
          env:
            - {name: POSTGRES_USER, value: postgres}
            - {name: POSTGRES_DB, value: postgres}
            - {name: PGDATA, value: /var/lib/postgresql/18/docker}
            - {name: POSTGRES_PASSWORD_FILE, value: /run/auth/password}
            - {name: POSTGRES_INITDB_ARGS, value: '--auth-host=scram-sha-256 --auth-local=scram-sha-256'}
          startupProbe:
            exec: {command: [pg_isready, -U, postgres]}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec: {command: [pg_isready, -U, postgres]}
            periodSeconds: 10
          livenessProbe:
            exec: {command: [pg_isready, -U, postgres]}
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: run, mountPath: /var/run/postgresql}
            - {name: shm, mountPath: /dev/shm}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: {{ name }}-data}}
        - {name: auth, secret: {secretName: {{ name }}-auth, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
        - {name: run, emptyDir: {sizeLimit: 16Mi}}
        - {name: shm, emptyDir: {medium: Memory, sizeLimit: 128Mi}}
{% endif %}
