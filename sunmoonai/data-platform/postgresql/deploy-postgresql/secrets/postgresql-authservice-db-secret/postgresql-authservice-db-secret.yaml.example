apiVersion: v1
kind: Secret
metadata:
  name: postgresql-authservice-db-secret
  namespace: data-platform-dev
type: Opaque
stringData:
  DB_HOST: "postgresql-sunmoonai.data-platform-dev.svc.cluster.local"
  DB_PORT: "5432"
  DB_NAME: "auth_db"
  DB_USER: "sunmoonai_dev"
  # DB_PASSWORD: "CHANGE_ME"
  DB_SSLMODE: "disable"
---
# Auth Service 数据库连接信息 Secret
# 用途：为 auth-service 提供 auth_db 数据库的连接配置
# 注意：与 postgresql-auth-secret（PostgreSQL 认证密码）区分开
# 仅归档/占位用途：实际由统一密管创建与更新；本文件用于结构对齐

