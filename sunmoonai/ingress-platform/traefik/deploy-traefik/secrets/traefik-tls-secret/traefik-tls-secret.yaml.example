# 此文件为结构示例，请勿直接 apply。
# 实际部署时由 deploy-traefik-tls-secret.sh 从 ca/、server-cert/ 生成 traefik-tls-secret.yaml（该文件已加入 .gitignore，各集群各自生成、不提交）。
apiVersion: v1
kind: Secret
metadata:
  name: traefik-tls-secret
  namespace: ingress-platform-dev
type: kubernetes.io/tls
data:
  tls.crt: ""
  tls.key: ""
  ca.crt: ""
