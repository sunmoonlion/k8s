apiVersion: v1
kind: ConfigMap
metadata: {name: '{{ application_name }}-rabbitmq-provision-{{ cfg.rabbitmq_identity_revision }}', namespace: {{ messaging_namespace }}}
data:
  provision.py: |
{{ lookup('template', mechanism_root + '/rabbitmq/provision.py.j2') | regex_replace('\n+$', '') | indent(4, true) }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: {{ application_name }}-rabbitmq-provision-in, namespace: {{ messaging_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: rabbitmq}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app.kubernetes.io/name: {{ application_name }}-rabbitmq-provision}}
      ports: [{protocol: TCP, port: 5672}, {protocol: TCP, port: 15672}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: {{ application_name }}-rabbitmq-provision-out, namespace: {{ messaging_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: {{ application_name }}-rabbitmq-provision}}
  policyTypes: [Egress]
  egress:
    - to:
        - podSelector: {matchLabels: {app.kubernetes.io/name: rabbitmq}}
      ports: [{protocol: TCP, port: 5672}, {protocol: TCP, port: 15672}]
---
apiVersion: batch/v1
kind: Job
metadata: {name: '{{ application_name }}-rabbitmq-{{ cfg.rabbitmq_identity_revision }}', namespace: {{ messaging_namespace }}}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 180
  template:
    metadata:
      labels: {app.kubernetes.io/name: {{ application_name }}-rabbitmq-provision, app.kubernetes.io/part-of: {{ application_name }}}
    spec:
      restartPolicy: Never
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1001, runAsGroup: 1001, fsGroup: 1001, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: provision
          image: {{ registry_address }}/platform/{{ app_images.backend.repository }}@{{ app_images.backend.digest }}
          imagePullPolicy: IfNotPresent
          command: [python, /script/provision.py]
          env:
            - {name: RABBITMQ_HOST, value: 'rabbitmq.{{ messaging_namespace }}.svc.cluster.local'}
            - {name: APP_RABBITMQ_USER, value: '{{ cfg.rabbitmq_user }}'}
            - {name: APP_RABBITMQ_VHOST, value: '{{ cfg.rabbitmq_vhost }}'}
            - {name: APP_RABBITMQ_QUEUE, value: '{{ cfg.rabbitmq_queue }}'}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: '1', memory: 256Mi}}
          volumeMounts:
            - {name: script, mountPath: /script, readOnly: true}
            - {name: admin, mountPath: /run/admin, readOnly: true}
            - {name: app, mountPath: /run/app, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: script, configMap: {name: '{{ application_name }}-rabbitmq-provision-{{ cfg.rabbitmq_identity_revision }}'}}
        - {name: admin, secret: {secretName: rabbitmq-auth, items: [{key: username, path: username}, {key: password, path: password}], defaultMode: 0440}}
        - {name: app, secret: {secretName: {{ application_name }}-rabbitmq-provision, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 32Mi}}
