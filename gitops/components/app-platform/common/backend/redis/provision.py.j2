"""Provision one bounded Redis identity and verify its real access, without secret output."""
import hashlib
import json
import os
import re
from pathlib import Path
import uuid
import redis


def run():
    username = os.environ['APP_REDIS_USER']
    pattern = os.environ['APP_REDIS_KEY_PATTERN']
    if not re.fullmatch(r'[a-z][a-z0-9_]{1,40}', username) or username == 'default' or pattern != '{{ application_name }}:*':
        raise RuntimeError('Unexpected identity boundary')
    password = Path('/run/app/password').read_text()
    digest = hashlib.sha256(password.encode()).hexdigest()
    admin = redis.Redis(host=os.environ['REDIS_HOST'], password=Path('/run/admin/password').read_text(),
                        decode_responses=True, socket_connect_timeout=5, socket_timeout=5)
    client = redis.Redis(host=os.environ['REDIS_HOST'], username=username, password=password,
                         decode_responses=True, socket_connect_timeout=5, socket_timeout=5)
    key = '{{ application_name }}:acceptance:' + uuid.uuid4().hex
    foreign = 'other-app:acceptance:' + uuid.uuid4().hex
    try:
        assert admin.config_get('aclfile') == {'aclfile': '/data/users.acl'}
        previous = admin.acl_getuser(username)
        if previous and previous['passwords'] != [digest]:
            raise RuntimeError('Refusing an existing identity with different credentials')
        rules = ['reset', 'on', '#' + digest, '~' + pattern, 'resetchannels', '-@all',
                 '+ping', '+hello', '+select', '+client|setname', '+client|setinfo',
                 '+get', '+getdel', '+set', '+del', '+exists', '+expire', '+pexpire',
                 '+ttl', '+pttl', '+mget', '+mset', '+incr', '+incrby', '+decr', '+decrby',
                 '+multi', '+exec', '+discard', '+watch', '+unwatch']
{% if cfg.redis_pubsub_channel_pattern | default('') %}
        channel_pattern = '{{ cfg.redis_pubsub_channel_pattern }}'
        if channel_pattern != '{{ application_name }}:workbench:*':
            raise RuntimeError('Unexpected channel boundary')
        rules.extend(['&' + channel_pattern, '+publish', '+subscribe', '+unsubscribe'])
{% endif %}
        assert admin.execute_command('ACL', 'SETUSER', username, *rules) == 'OK'
        assert admin.acl_save()
        assert client.ping()
        assert client.set(key, 'checked', ex=60)
        assert client.getdel(key) == 'checked'
{% if cfg.redis_pubsub_channel_pattern | default('') %}
        # 实际订阅/发布，并核对外部频道和管理权限仍被拒绝。
        channel = '{{ application_name }}:workbench:acceptance:' + uuid.uuid4().hex
        with client.pubsub() as subscription:
            subscription.subscribe(channel)
            ack = subscription.get_message(timeout=5)
            if not ack or ack['type'] != 'subscribe':
                raise RuntimeError('Subscription not acknowledged')
            assert client.publish(channel, 'checked') == 1
            message = subscription.get_message(timeout=5)
            if not message or message['type'] != 'message' or message['data'] != 'checked':
                raise RuntimeError('Event not received')
            subscription.unsubscribe(channel)
        try:
            client.publish('other-app:workbench:acceptance', 'must-not-publish')
        except redis.exceptions.NoPermissionError:
            pass
        else:
            raise RuntimeError('Foreign channel unexpectedly writable')
        for forbidden in ['other-app:workbench:acceptance', '{{ application_name }}:outside-workbench']:
            try:
                with client.pubsub() as subscription:
                    subscription.subscribe(forbidden)
                    subscription.get_message(timeout=5)
            except redis.exceptions.NoPermissionError:
                pass
            else:
                raise RuntimeError('Foreign channel unexpectedly readable')
{% endif %}
        try:
            client.set(foreign, 'must-not-write', ex=60)
        except redis.exceptions.NoPermissionError:
            pass
        else:
            admin.delete(foreign)
            raise RuntimeError('Foreign key unexpectedly writable')
        try:
            client.config_get('maxmemory')
        except redis.exceptions.NoPermissionError:
            pass
        else:
            raise RuntimeError('Management command unexpectedly allowed')
        # Never execute FLUSHALL to test denial. ACL DRYRUN only evaluates authorization.
        try:
            decision = admin.execute_command('ACL', 'DRYRUN', username, 'FLUSHALL')
        except redis.exceptions.ResponseError as denied:
            decision = str(denied)
        expected = "User " + username + " has no permissions to run the 'flushall' command"
        if decision != expected:
            raise RuntimeError('Expected explicit destructive command denial')
        print(json.dumps({'redis_user': username, 'key_pattern': pattern, 'write_read': True,
{% if cfg.redis_pubsub_channel_pattern | default('') %}
                          'pubsub_channel_pattern': channel_pattern, 'pubsub_roundtrip': True,
                          'foreign_channel_denied': True,
{% endif %}
                          'foreign_key_denied': True, 'admin_command_denied': True,
                          'flushall_permission_denied': True, 'acl_saved': True}))
    finally:
        admin.delete(key)
        client.close()
        admin.close()


if __name__ == '__main__':
    try:
        run()
    except Exception as error:
        raise SystemExit('Redis identity failed: ' + type(error).__name__)
