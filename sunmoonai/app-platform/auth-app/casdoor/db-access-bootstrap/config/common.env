SERVICE_NAME=casdoor
ENVIRONMENT=dev

# Service namespace (for k8s outputs and in-cluster defaults)
NAMESPACE=app-platform-dev

# Which engines to manage for this service
ENABLE_POSTGRESQL=true
ENABLE_REDIS=false
ENABLE_MONGODB=false

# Paths
WORKSPACE_ROOT="$(cd "${SCRIPT_DIR}/../../../../../.." && pwd)"
K8S_ROOT="$(cd "${SCRIPT_DIR}/../../../../.." && pwd)"
if [[ -z "${DBCTL_BIN:-}" ]]; then
  DBCTL_BIN="${WORKSPACE_ROOT}/investment-app/investment-web-backend/db-provisioner/bin/dbctl"
fi

# PostgreSQL 临时 client pod 镜像也必须按集群解析 Harbor 地址：
# KIND -> harbor.sunmoonai.com:30443，远程集群 -> harbor.sunmoonai.com。
if [[ -z "${PG_CLIENT_IMAGE:-}" && -z "${POSTGRESQL_CLIENT_IMAGE:-}" ]]; then
  if [[ -f "${K8S_ROOT}/utils/cluster-config-mapping.sh" ]]; then
    # shellcheck disable=SC1091
    source "${K8S_ROOT}/utils/cluster-config-mapping.sh"
    POSTGRESQL_CLIENT_IMAGE="$(get_cluster_harbor_registry)/k8s-images/postgresql:17.6.0-debian-12-r4"
  else
    POSTGRESQL_CLIENT_IMAGE="harbor.sunmoonai.com/k8s-images/postgresql:17.6.0-debian-12-r4"
  fi
fi

# Casdoor 是第三方 Helm chart，没有本地 .env 模板
# setup-external-db-access.sh 只做 DB provision，不生成 app env 文件
BASE_ENV_TEMPLATE=/dev/null
OUT_ENV=/tmp/casdoor-db.env

# 关闭模板文件检查（Casdoor 无本地源码目录）
STRICT_FILE_CHECK=false
