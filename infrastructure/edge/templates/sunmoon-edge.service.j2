[Unit]
Description=SunMoon public edge (Traefik + frps)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ edge_config_dir }}
ExecStart=/usr/bin/docker compose -f {{ edge_config_dir }}/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ edge_config_dir }}/compose.yaml down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
