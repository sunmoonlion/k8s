{% for name,port,enabled in [('postgresql',5432,services_postgresql_enabled),('redis',6379,services_redis_enabled),('rabbitmq',5672,services_rabbitmq_enabled)] if enabled and name == render_component %}
{% set image = image_map[name] %}
{% set volume = services_volumes | selectattr('name','equalto',name) | first %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-headless
  namespace: {{ component_namespaces[name] }}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: {{ name }}}
  ports: [{name: service, port: {{ port }}, targetPort: {{ port }}}]
---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ component_namespaces[name] }}
spec:
  selector: {app.kubernetes.io/name: {{ name }}}
  ports:
    - {name: service, port: {{ port }}, targetPort: {{ port }}}
{% if name == 'rabbitmq' %}
    - {name: management, port: 15672, targetPort: 15672}
{% endif %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ name }}
  namespace: {{ component_namespaces[name] }}
spec:
  serviceName: {{ name }}-headless
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: {{ name }}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: {{ name }}, app.kubernetes.io/part-of: sunmoon-platform}
    spec:
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
{% if name == 'rabbitmq' %}
      # Single-node persistent identity, independent of the namespace Service DNS.
      hostAliases:
        - ip: '127.0.0.1'
          hostnames: ['{{ rabbitmq_node_hostname }}']
{% endif %}
      nodeSelector:
        kubernetes.io/hostname: {{ cluster_name }}-{{ volume.node }}
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ volume.uid }}
        runAsGroup: {{ volume.gid }}
        fsGroup: {{ volume.gid }}
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
{% if name == 'rabbitmq' %}
      initContainers:
        - name: cookie
          image: {{ registry_address }}/platform/{{ name }}@{{ image.manifest_digest }}
          command: [/bin/sh, -ec]
          args:
            - 'if [ ! -e /var/lib/rabbitmq/.erlang.cookie ]; then cp /run/auth/erlang-cookie /var/lib/rabbitmq/.erlang.cookie; chmod 600 /var/lib/rabbitmq/.erlang.cookie; fi; cmp --silent /run/auth/erlang-cookie /var/lib/rabbitmq/.erlang.cookie'
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {cpu: 100m, memory: 64Mi}}
          volumeMounts:
            - {name: data, mountPath: /var/lib/rabbitmq}
            - {name: auth, mountPath: /run/auth, readOnly: true}
{% endif %}
      containers:
        - name: {{ name }}
          image: {{ registry_address }}/platform/{{ name }}@{{ image.manifest_digest }}
          imagePullPolicy: IfNotPresent
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources:
            requests: {cpu: 100m, memory: {{ '256Mi' if name != 'redis' else '128Mi' }}}
            limits: {cpu: '2', memory: {{ '1Gi' if name != 'redis' else '512Mi' }}}
          ports:
            - {name: service, containerPort: {{ port }}}
{% if name == 'rabbitmq' %}
            - {name: management, containerPort: 15672}
{% endif %}
{% if name == 'postgresql' %}
          env:
            - {name: POSTGRES_USER, value: postgres}
            - {name: POSTGRES_DB, value: postgres}
            - {name: PGDATA, value: /var/lib/postgresql/18/docker}
            - {name: POSTGRES_PASSWORD_FILE, value: /run/auth/password}
            - {name: POSTGRES_INITDB_ARGS, value: '--auth-host=scram-sha-256 --auth-local=scram-sha-256'}
          startupProbe:
            exec: {command: [pg_isready, -U, postgres]}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec: {command: [pg_isready, -U, postgres]}
            periodSeconds: 10
          livenessProbe:
            exec: {command: [pg_isready, -U, postgres]}
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: run, mountPath: /var/run/postgresql}
            - {name: shm, mountPath: /dev/shm}
{% elif name == 'redis' %}
          command: [redis-server, /run/auth/redis.conf]
          startupProbe:
            exec: {command: [/bin/sh, -ec, 'REDISCLI_AUTH="$(cat /run/auth/password)" redis-cli ping | grep -qx PONG']}
            periodSeconds: 5
            failureThreshold: 36
          readinessProbe:
            exec: {command: [/bin/sh, -ec, 'REDISCLI_AUTH="$(cat /run/auth/password)" redis-cli ping | grep -qx PONG']}
            periodSeconds: 10
          livenessProbe:
            tcpSocket: {port: 6379}
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: auth, mountPath: /run/auth, readOnly: true}
{% else %}
          env:
            - {name: POD_NAME, valueFrom: {fieldRef: {fieldPath: metadata.name}}}
            - {name: RABBITMQ_USE_LONGNAME, value: 'true'}
            - {name: RABBITMQ_NODENAME, value: 'rabbit@{{ rabbitmq_node_hostname }}'}
            - {name: RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS, value: '+S 2:2'}
          startupProbe:
            exec: {command: [rabbitmq-diagnostics, -q, ping]}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec: {command: [rabbitmq-diagnostics, -q, check_running]}
            periodSeconds: 20
            timeoutSeconds: 10
          livenessProbe:
            exec: {command: [rabbitmq-diagnostics, -q, ping]}
            periodSeconds: 30
            timeoutSeconds: 10
          volumeMounts:
            - {name: data, mountPath: /var/lib/rabbitmq}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: auth, mountPath: /etc/rabbitmq/conf.d/20-sunmoon.conf, subPath: rabbitmq.conf, readOnly: true}
{% endif %}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: {{ name }}-data}}
        - {name: auth, secret: {secretName: {{ name }}-auth, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
{% if name == 'postgresql' %}
        - {name: run, emptyDir: {sizeLimit: 16Mi}}
        - {name: shm, emptyDir: {medium: Memory, sizeLimit: 128Mi}}
{% endif %}
{% endfor %}
