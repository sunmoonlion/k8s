{% for name,stage,dependency in [('tpl-database','database','platform-services'),('tpl-migration','migration','tpl-database'),('tpl-redis','redis','tpl-migration')] if cfg.enabled %}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata: {name: {{ name }}, namespace: flux-system}
spec:
  interval: 5m
  retryInterval: 30s
  timeout: 8m
  path: ./components/app-platform/tpl-app/tpl-backend/{{ stage }}
  sourceRef: {kind: OCIRepository, name: platform}
  dependsOn: [{name: {{ dependency }}}]
  prune: false
  deletionPolicy: Orphan
  wait: true
  decryption:
    provider: sops
    secretRef: {name: sops-age}
{% endfor %}
