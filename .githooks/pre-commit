#!/bin/sh
# 文档不变量门禁。装一次即对本仓全部 worktree 生效（它们共享同一个 .git）：
#     git config core.hooksPath .githooks
#
# 只检查本次提交暂存的 sunmoonai/docs/ 下的 markdown，判定基准是 git 索引而不是
# 文件系统——因此结论不随工作区状态变化。理由见 sunmoonai/docs/tools/doc-gate.py
# 顶部说明，以及 constraints.md「保证这些被遵守的三层」。
#
# 确需绕过时用 git commit --no-verify，但绕过就是把这条降回纪律层，请在提交说明
# 里写清为什么。

set -e

root=$(git rev-parse --show-toplevel)
gate="$root/sunmoonai/docs/tools/doc-gate.py"

# ⚠ 首版是 `[ -f "$gate" ] || exit 0`——脚本被移动或改名后，门**静默失效**，
# 提交照过、没有任何提示。这正是 constraints「判据必须声明覆盖范围」点名的那类错。
# 改为缺脚本即判失败；确需绕过用 git commit --no-verify。
if [ ! -f "$gate" ]; then
  echo "门禁脚本不在：$gate" >&2
  echo "移动或改名了就同步改 .githooks/；确需绕过用 --no-verify 并在提交说明写清理由。" >&2
  exit 1
fi

python3 "$gate" --staged

anchor="$root/sunmoonai/docs/tools/anchor-gate.py"
if [ ! -f "$anchor" ]; then
  echo "门禁脚本不在：$anchor" >&2
  exit 1
fi
python3 "$anchor"
