apiVersion: v1
kind: ConfigMap
metadata: {name: '{{ application_name }}-identity-provision-{{ cfg.identity_revision }}', namespace: {{ app_namespace }}}
data:
  provision.py: |
{{ lookup('template', mechanism_root + '/identity/provision.py.j2') | regex_replace('\n+$', '') | indent(4, true) }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: {{ application_name }}-identity-provision-in, namespace: {{ app_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: casdoor}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app.kubernetes.io/name: {{ application_name }}-identity-provision}}
      ports: [{protocol: TCP, port: 8000}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: {{ application_name }}-identity-provision-out, namespace: {{ app_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: {{ application_name }}-identity-provision}}
  policyTypes: [Egress]
  egress:
    - to:
        - podSelector: {matchLabels: {app.kubernetes.io/name: casdoor}}
      ports: [{protocol: TCP, port: 8000}]
---
apiVersion: batch/v1
kind: Job
metadata: {name: '{{ application_name }}-identity-{{ cfg.identity_revision }}', namespace: {{ app_namespace }}}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 180
  template:
    metadata:
      labels: {app.kubernetes.io/name: {{ application_name }}-identity-provision, app.kubernetes.io/part-of: {{ application_name }}}
    spec:
      restartPolicy: Never
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1001, runAsGroup: 1001, fsGroup: 1001, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: provision
          image: {{ registry_address }}/platform/{{ app_images.backend.repository }}@{{ app_images.backend.digest }}
          imagePullPolicy: IfNotPresent
          command: [python, /script/provision.py]
          env:
            - {name: CASDOOR_INTERNAL_ENDPOINT, value: 'http://casdoor.{{ app_namespace }}.svc.cluster.local:8000'}
            - {name: CASDOOR_ORIGIN, value: 'https://{{ casdoor_hostname }}:30443'}
            - {name: CASDOOR_ORGANIZATION, value: '{{ cfg.identity_organization }}'}
            - name: BROWSER_CLIENTS
              value: {{ browser_clients | to_json | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: '1', memory: 256Mi}}
          volumeMounts:
            - {name: script, mountPath: /script, readOnly: true}
            - {name: admin, mountPath: /run/admin, readOnly: true}
            - {name: app, mountPath: /run/app, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: script, configMap: {name: '{{ application_name }}-identity-provision-{{ cfg.identity_revision }}'}}
        - {name: admin, secret: {secretName: casdoor-initial-identity, items: [{key: init_data.json, path: init_data.json}], defaultMode: 0440}}
        - {name: app, secret: {secretName: {{ application_name }}-identity-provision, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 32Mi}}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: {{ application_name }}-browser-identity, namespace: {{ app_namespace }}}
data:
  CASDOOR_ENDPOINT: 'https://{{ casdoor_hostname }}:30443'
  CASDOOR_ORGANIZATION: '{{ cfg.identity_organization }}'
{% for surface, client in browser_clients.items() %}
  {{ surface | upper }}_CASDOOR_APPLICATION: '{{ client.name }}'
  {{ surface | upper }}_CASDOOR_CLIENT_ID: '{{ client.client_id }}'
  {{ surface | upper }}_CASDOOR_REDIRECT_URI: '{{ client.origin }}/api/auth/{{ surface }}/callback'
  {{ surface | upper }}_FRONTEND_BASE_URL: '{{ client.origin }}'
  {{ surface | upper }}_FRONTEND_ALLOWED_ORIGINS: '{{ client.origin }}'
{% endfor %}
