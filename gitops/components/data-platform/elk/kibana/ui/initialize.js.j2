'use strict';
const {request,readAuth}=require('./tls-client');
const fs=require('node:fs');
const user={{ kibana_ui_viewer_user | to_json }};
const owner={{ (cluster_name + '/kibana-ui') | to_json }};
const index={{ (elk_index_prefix + '-*') | to_json }};
const admin=readAuth('/run/admin');
const viewer=readAuth('/run/auth');
const password=fs.readFileSync('/run/auth/password','utf8').trim();
const desired={metadata:{sunmoon_owner:owner},elasticsearch:{cluster:[],indices:[{names:[index],privileges:['read','view_index_metadata']}]},kibana:[{base:['read'],feature:{},spaces:['default']}]};
const same=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
function status(r,expected,scope){if(r.status!==expected)throw new Error(scope+' HTTP '+r.status);}
function ownedRole(r){
  const es=r.elasticsearch,kb=r.kibana,idx=es?.indices?.[0];
  return r.metadata?.sunmoon_owner===owner && same(es?.cluster,[]) && (es.run_as||[]).length===0 &&
    (es.remote_indices||[]).length===0 && (es.remote_cluster||[]).length===0 && es.indices?.length===1 &&
    same(idx.names,[index]) && same([...idx.privileges].sort(),['read','view_index_metadata']) &&
    !idx.allow_restricted_indices && !idx.field_security && !idx.query && kb?.length===1 &&
    same(kb[0].base,['read']) && Object.keys(kb[0].feature||{}).length===0 && same(kb[0].spaces,['default']);
}
(async()=>{
  const rolePath='/api/security/role/'+encodeURIComponent(user);
  let role=await request('kibana','GET',rolePath,admin);
  if(role.status===404){role=await request('kibana','PUT',rolePath+'?createOnly=true',admin,desired);status(role,204,'Create read-only browser role');}
  else {status(role,200,'Read browser role');if(!ownedRole(role.data))throw new Error('Refuse changing a foreign or broadened browser role');}
  const path='/_security/user/'+encodeURIComponent(user);
  let existing=await request('elasticsearch','GET',path,admin);
  if(existing.status===404 || (existing.status===200 && Object.keys(existing.data).length===0)){
    const created=await request('elasticsearch','PUT',path,admin,{password,roles:[user],metadata:{sunmoon_owner:owner}});status(created,200,'Create independent human reader');
  }else{
    status(existing,200,'Read browser identity');const u=existing.data[user];
    if(!u||u.metadata?.sunmoon_owner!==owner||!same(u.roles,[user])||!u.enabled)throw new Error('Refuse adopting a foreign or disabled browser identity');
  }
  const auth=await request('elasticsearch','GET','/_security/_authenticate',viewer);status(auth,200,'Authenticate human reader');
  if(auth.data.username!==user||!same(auth.data.roles,[user]))throw new Error('Human reader identity differs');
  const privileges=await request('elasticsearch','POST','/_security/user/_has_privileges',viewer,{cluster:['manage_security'],index:[{names:[index],privileges:['read','write','view_index_metadata']},{names:['sunmoon-kibana-foreign-check'],privileges:['read']}]});
  status(privileges,200,'Check human reader permissions');
  const own=privileges.data.index?.[index],other=privileges.data.index?.['sunmoon-kibana-foreign-check'];
  if(!own?.read||!own.view_index_metadata||own.write||other?.read||privileges.data.cluster?.manage_security)throw new Error('Human reader permissions differ');
  status(await request('elasticsearch','GET','/_security/user',viewer),403,'User administration must be denied');
  status(await request('kibana','GET','/api/data_views/data_view/{{ elk_log_data_view_id }}',viewer),200,'Read prepared application log view');
  role=await request('kibana','GET',rolePath,admin);status(role,200,'Verify persisted role');if(!ownedRole(role.data))throw new Error('Persisted reader role differs');
  console.log(JSON.stringify({passed:true,independent_human_reader:true,default_space_read_only:true,application_logs_only:true,write_and_admin_denied:true,data_view_readable:true}));
})().catch(error=>{console.error(error.message);process.exitCode=1;});
