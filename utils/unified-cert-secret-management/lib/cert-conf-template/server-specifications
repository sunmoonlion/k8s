# ===========================================
# 服务器证书生成配置模板
# 用途：生成服务器证书和私钥
# 文件名：server-conf-template
# ===========================================

[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no
# 密钥长度：服务器证书使用2048位
default_bits = 2048
# 哈希算法：使用SHA-256
default_md = sha256

[req_distinguished_name]
# 国家代码：ISO 3166-1 alpha-2 标准
C = CN
# 省份/州
ST = Beijing
# 城市
L = Beijing
# 组织名称
O = SunMoonAI
# 组织单位
OU = IT
# 通用名称：服务器的主要域名
CN = harbor-4.sunmoonai.local

[v3_req]
# 服务器证书的密钥用途：
# - digitalSignature: 数字签名
# - keyEncipherment: 密钥加密
# 注意：不包含 dataEncipherment，因为现代浏览器（特别是 Chrome/Edge）会拒绝包含 dataEncipherment 的证书
# 现代 TLS（特别是 TLS 1.3）不再使用 dataEncipherment
keyUsage = digitalSignature, keyEncipherment
# 服务器证书的扩展用途：
# - serverAuth: 服务器认证
# - clientAuth: 客户端认证（双向认证）
extendedKeyUsage = serverAuth, clientAuth
# 基本约束：不是CA
basicConstraints = CA:FALSE
# 证书标识
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
# 现代浏览器主要依赖SANs进行域名验证
subjectAltName = @alt_names

[alt_names]
# 主要域名：与CN字段保持一致
DNS.1 = harbor-4.sunmoonai.local
# 备用域名：支持多域名访问
DNS.2 = harbor.sunmoonai.local
# 本地访问域名
DNS.3 = localhost
# IPv4地址：本地回环地址
IP.1 = 127.0.0.1
# IPv4地址：服务器公网IP
IP.2 = 115.190.37.57

# ===========================================
# 配置说明：
# 1. 修改 CN 字段为您的服务器主域名
# 2. 在 [alt_names] 部分添加所有需要支持的域名和IP
# 3. DNS.x 用于域名，IP.x 用于IP地址
# 4. 现代浏览器主要依赖SANs进行域名验证
# 5. extendedKeyUsage 包含 serverAuth 用于HTTPS服务
# 6. 如需支持更多域名，继续添加 DNS.3, DNS.4 等
# ===========================================

# =============================================================================
# 个性化配置项 - 需要根据实际需求修改
# =============================================================================

# 证书有效期（天）
DAYS = 365

# 密钥长度（位）
KEY_SIZE = 2048
