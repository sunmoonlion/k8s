{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/research/runtime/v1/create-run.schema.json",
  "title": "Research Runtime Create Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "idempotency_key",
    "operation_id",
    "delegated_user",
    "input"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "idempotency_key": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "delegated_user": {
      "$ref": "https://contracts.sunmoonai.com/research/runtime/v1/delegated-context.schema.json"
    },
    "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 20000}
      }
    }
  }
}
