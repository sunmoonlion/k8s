{% set volume = valkey_volume %}
---
apiVersion: v1
kind: Service
metadata: {name: valkey-headless, namespace: {{ data_namespace }}}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: valkey}
  ports: [{name: service, port: 6379, targetPort: 6379}]
---
apiVersion: v1
kind: Service
metadata: {name: valkey, namespace: {{ data_namespace }}}
spec:
  selector: {app.kubernetes.io/name: valkey}
  ports: [{name: service, port: 6379, targetPort: 6379}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: valkey, namespace: {{ data_namespace }}}
spec:
  serviceName: valkey-headless
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: valkey}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: valkey, app.kubernetes.io/part-of: ragflow}
      annotations: {sunmoonai.com/input-digest: '{{ valkey_input_digest }}'}
    spec:
      enableServiceLinks: false
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 90
      nodeSelector: {kubernetes.io/hostname: '{{ cluster_name }}-{{ volume.node }}'}
      securityContext: {runAsNonRoot: true, runAsUser: {{ volume.uid }}, runAsGroup: {{ volume.gid }}, fsGroup: {{ volume.gid }}, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: valkey
          image: {{ registry_address }}/platform/valkey@{{ image_map.valkey.manifest_digest }}
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -ec]
          args: ['umask 077; exec valkey-server /run/auth/valkey.conf']
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          ports: [{name: service, containerPort: 6379}]
          resources: {{ valkey_resources | to_json }}
          startupProbe:
            exec: {command: [/bin/sh, -ec, 'export VALKEYCLI_AUTH="$(cat /run/auth/probe-password)"; valkey-cli --user {{ valkey_probe_username }} ping | grep -qx PONG']}
            periodSeconds: 5
            failureThreshold: 120
          readinessProbe:
            exec: {command: [/bin/sh, -ec, 'export VALKEYCLI_AUTH="$(cat /run/auth/probe-password)"; valkey-cli --user {{ valkey_probe_username }} ping | grep -qx PONG']}
            periodSeconds: 10
          livenessProbe:
            tcpSocket: {port: service}
            periodSeconds: 30
            failureThreshold: 5
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: valkey-data}}
        - {name: auth, secret: {secretName: valkey-auth, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: valkey-clients, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: valkey}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app.kubernetes.io/name: ragflow}}
      ports: [{protocol: TCP, port: 6379}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: ragflow-valkey-egress, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: ragflow}}
  policyTypes: [Egress]
  egress:
    - to:
        - podSelector: {matchLabels: {app.kubernetes.io/name: valkey}}
      ports: [{protocol: TCP, port: 6379}]
