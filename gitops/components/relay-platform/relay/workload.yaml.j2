apiVersion: v1
kind: Service
metadata: {name: relay, namespace: {{ relay_namespace }}}
spec:
  selector: {app.kubernetes.io/name: relay}
  ports: [{name: ws, port: {{ relay_port }}, targetPort: ws}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: relay, namespace: {{ relay_namespace }}}
spec:
  replicas: 1
  revisionHistoryLimit: 3
  selector: {matchLabels: {app.kubernetes.io/name: relay}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: relay}
      annotations: {sunmoonai.com/input-sha256: '{{ relay_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      enableServiceLinks: false
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 10002, runAsGroup: 10002, fsGroup: 10002, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: relay
          image: {{ registry_address }}/{{ relay_image.harbor_project | default('platform') }}/{{ relay_image.repository }}@{{ relay_image.digest }}
          imagePullPolicy: IfNotPresent
          env:
            - {name: RELAY_HOST, value: 0.0.0.0}
            - {name: RELAY_PORT, value: '{{ relay_port }}'}
            - {name: RELAY_NAME, value: '{{ relay_name }}'}
            - {name: RELAY_TOKENS_FILE, value: /secrets/tokens.json}
            - {name: RELAY_TOKENS_STATE, value: /state/tokens.json}
            - {name: RELAY_ADMIN_TOKEN, valueFrom: {secretKeyRef: {name: relay-auth, key: RELAY_ADMIN_TOKEN}}}
            - {name: RELAY_JWT_ISSUER, value: sunmoon-workbench}
            - {name: RELAY_JWT_PUBLIC_KEY, valueFrom: {secretKeyRef: {name: relay-auth, key: RELAY_JWT_PUBLIC_KEY}}}
          ports: [{name: ws, containerPort: {{ relay_port }}}]
          startupProbe: {httpGet: {path: /healthz, port: ws}, periodSeconds: 5, failureThreshold: 24}
          readinessProbe: {httpGet: {path: /healthz, port: ws}, periodSeconds: 10, timeoutSeconds: 3}
          livenessProbe: {httpGet: {path: /healthz, port: ws}, periodSeconds: 20, timeoutSeconds: 3}
          resources: {{ relay_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: tokens, mountPath: /secrets, readOnly: true}
            - {name: state, mountPath: /state}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: tokens, secret: {secretName: relay-auth, items: [{key: tokens.json, path: tokens.json}], defaultMode: 0440}}
        - {name: state, emptyDir: {sizeLimit: 8Mi}}
        - {name: tmp, emptyDir: {sizeLimit: 16Mi}}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: relay
  namespace: {{ relay_namespace }}
  annotations: {kubernetes.io/ingress.class: sunmoon}
spec:
  entryPoints: [websecure]
  routes:
    - kind: Rule
      match: 'Host(`{{ relay_origin | urlsplit("hostname") }}`)'
      services: [{name: relay, port: ws, scheme: http}]
  tls: {secretName: relay-tls}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: relay-ingress, namespace: {{ relay_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: relay}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ ingress_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: traefik}}
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ app_namespace }}'}}
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ sandbox_namespace }}'}}
      ports: [{protocol: TCP, port: {{ relay_port }}}]
