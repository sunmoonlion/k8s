#!/bin/sh
# 合并提交同样过门禁。最要紧的是：挡住从助手分支合并过来的、对主线独有文档的删除。
# 各助手分支不保留 human 那份与本轮归档记录；git 的语义会把这些删除传播到主线，
# 这对每个分支都成立，因此用门禁挡，不靠「记得别合某个分支」。
set -e
root=$(git rev-parse --show-toplevel)
gate="$root/sunmoonai/docs/dev-investment-agent/tools/doc-gate.py"
# ⚠ 首版是 `[ -f "$gate" ] || exit 0`——脚本被移动或改名后，门**静默失效**，
# 提交照过、没有任何提示。这正是 constraints「判据必须声明覆盖范围」点名的那类错。
# 改为缺脚本即判失败；确需绕过用 git commit --no-verify。
if [ ! -f "$gate" ]; then
  echo "门禁脚本不在：$gate" >&2
  echo "移动或改名了就同步改 .githooks/；确需绕过用 --no-verify 并在提交说明写清理由。" >&2
  exit 1
fi
python3 "$gate" --staged

anchor="$root/sunmoonai/docs/dev-investment-agent/tools/anchor-gate.py"
if [ ! -f "$anchor" ]; then
  echo "门禁脚本不在：$anchor" >&2
  exit 1
fi
python3 "$anchor"
