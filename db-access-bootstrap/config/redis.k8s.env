SERVICE_NAME=auth-app-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=redis

# In-cluster Redis service (override as needed)
DB_HOST=redis-sunmoonai-master.data-platform-dev.svc.cluster.local
DB_PORT=6379

# auth-only mode (no ACL username management)
REDIS_AUTH_ONLY=true
REDIS_PASSWORD=${REDIS_PASSWORD:-StrongRedisPassw0rd!}
REDIS_DB_INDEX=0
APP_DB_NAME=auth-app-backend
APP_DB_USER=
APP_DB_PASSWORD=

OUTPUT_NAMESPACE=auth-app
OUTPUT_SECRET_NAME=auth-app-backend-redis-conn

DB_PRECHECK_ENABLED=true
DB_PRECHECK_TIMEOUT_SECONDS=60
DB_PRECHECK_INTERVAL_SECONDS=3
K8S_PRECHECK_ENABLED=true
K8S_PRECHECK_NAMESPACE=data-platform-dev
K8S_PRECHECK_LABEL_SELECTOR=app.kubernetes.io/name=redis,app.kubernetes.io/instance=redis-sunmoonai
