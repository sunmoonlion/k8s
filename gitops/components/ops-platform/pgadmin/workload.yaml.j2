apiVersion: v1
kind: Service
metadata: {name: pgadmin, namespace: {{ ops_namespace }}}
spec:
  selector: {app.kubernetes.io/name: pgadmin}
  ports: [{name: http, port: {{ pgadmin_port }}, targetPort: http}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: pgadmin, namespace: {{ ops_namespace }}}
spec:
  replicas: 1
  revisionHistoryLimit: 3
  strategy: {type: Recreate}
  selector: {matchLabels: {app.kubernetes.io/name: pgadmin}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: pgadmin, sunmoonai.com/postgresql-client: 'true'}
      annotations: {sunmoonai.com/input-sha256: '{{ pgadmin_input_digest }}'}
    spec:
      serviceAccountName: platform-runtime
      enableServiceLinks: false
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/hostname: '{{ cluster_name }}-{{ pgadmin_volume.node }}'}
      securityContext: {runAsNonRoot: true, runAsUser: 5050, runAsGroup: 5050, fsGroup: 5050, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: pgadmin
          image: {{ registry_address }}/platform/pgadmin@{{ image_map.pgadmin.manifest_digest }}
          imagePullPolicy: IfNotPresent
          env:
            - {name: PGADMIN_LISTEN_ADDRESS, value: 0.0.0.0}
            - {name: PGADMIN_LISTEN_PORT, value: '{{ pgadmin_port }}'}
            - {name: PGADMIN_CONFIG_SERVER_MODE, value: 'True'}
          envFrom: [{secretRef: {name: pgadmin-auth}}]
          ports: [{name: http, containerPort: {{ pgadmin_port }}}]
          startupProbe: {httpGet: {path: /misc/ping, port: http}, periodSeconds: 5, failureThreshold: 60}
          readinessProbe: {httpGet: {path: /misc/ping, port: http}, periodSeconds: 10, timeoutSeconds: 3}
          livenessProbe: {httpGet: {path: /misc/ping, port: http}, periodSeconds: 20, timeoutSeconds: 3}
          resources: {{ pgadmin_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: data, mountPath: /var/lib/pgadmin}
            - {name: tmp, mountPath: /tmp}
            # 启动时要建 /var/log/pgadmin；根文件系统只读，给它一块临时卷（2026-10-06 第 27 轮，退出 3）
            - {name: logs, mountPath: /var/log/pgadmin}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: pgadmin-data}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
        - {name: logs, emptyDir: {sizeLimit: 64Mi}}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: pgadmin
  namespace: {{ ops_namespace }}
  annotations: {kubernetes.io/ingress.class: sunmoon}
spec:
  entryPoints: [websecure]
  routes:
    - kind: Rule
      match: 'Host(`{{ pgadmin_origin | urlsplit("hostname") }}`)'
      services: [{name: pgadmin, port: http, scheme: http}]
  tls: {secretName: pgadmin-tls}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: pgadmin-ingress, namespace: {{ ops_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: pgadmin}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ ingress_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: traefik}}
      ports: [{protocol: TCP, port: {{ pgadmin_port }}}]
