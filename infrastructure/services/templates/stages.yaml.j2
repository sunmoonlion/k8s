{% for name,path,dependency,enabled in [('platform-services','core','',true),('casdoor-db','casdoor-db','platform-services',services_casdoor_enabled),('casdoor-init','casdoor-init','casdoor-db',services_casdoor_enabled),('casdoor','casdoor','casdoor-init',services_casdoor_enabled)] if enabled %}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata: {name: {{ name }}, namespace: flux-system}
spec:
  interval: 5m
  retryInterval: 30s
  timeout: {{ '8m' if name == 'platform-services' else '6m' }}
  path: ./components/{{ service_stage_paths[path] | default(path) }}
  sourceRef: {kind: OCIRepository, name: platform}
{% if dependency %}
  dependsOn: [{name: {{ dependency }}}]
{% endif %}
  prune: false
  deletionPolicy: Orphan
  wait: true
  decryption:
    provider: sops
    secretRef: {name: sops-age}
{% endfor %}
