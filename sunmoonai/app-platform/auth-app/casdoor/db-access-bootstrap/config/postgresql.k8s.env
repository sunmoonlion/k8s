SERVICE_NAME=casdoor
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=postgresql

# In-cluster PostgreSQL service
DB_HOST=postgresql-sunmoonai.data-platform-dev.svc.cluster.local
DB_PORT=5432

PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=${PG_ADMIN_PASSWORD:?set PG_ADMIN_PASSWORD in the operator environment}
PG_ADMIN_DB=postgres
# Casdoor 3.42.0 uses lib/pq, which rejects PostgreSQL's "prefer" mode.
# KIND reaches PostgreSQL over the in-cluster Service; TLS is not enabled here.
PG_SSLMODE=disable

# Tenant for this service
APP_DB_NAME=casdoor
APP_DB_USER=casdoor
APP_DB_PASSWORD=${APP_DB_PASSWORD:?set APP_DB_PASSWORD in the operator environment}

# Output secret（供 Helm chart 的 envFrom 引用）
OUTPUT_NAMESPACE=app-platform-dev
OUTPUT_SECRET_NAME=casdoor-postgresql-conn

# 从 WSL/部署机执行时经集群内临时 Pod 访问 .svc（与 deploy-casdoor 注释一致）
PG_USE_K8S_CLIENT=true
PG_CLIENT_NAMESPACE=data-platform-dev

# Precheck
DB_PRECHECK_ENABLED=true
DB_PRECHECK_TIMEOUT_SECONDS=60
DB_PRECHECK_INTERVAL_SECONDS=3
K8S_PRECHECK_ENABLED=true
K8S_PRECHECK_NAMESPACE=data-platform-dev
K8S_PRECHECK_LABEL_SELECTOR=app.kubernetes.io/name=postgresql,app.kubernetes.io/instance=sunmoonai
