SERVICE_NAME=auth-app-backend
ENVIRONMENT=dev

# Service namespace (for k8s outputs and in-cluster defaults)
NAMESPACE=auth-app

# Which engines to manage for this service
ENABLE_POSTGRESQL=true
ENABLE_REDIS=true
ENABLE_MONGODB=false

# Paths
DBCTL_BIN=/home/zym/k8s/utils/db-provisioner/bin/dbctl
BASE_ENV_TEMPLATE=/home/zym/app/auth-app-backend/.env.development
OUT_ENV=/home/zym/app/auth-app-backend/.env.c1-external

# Optional: enable strict check for required files
STRICT_FILE_CHECK=true
