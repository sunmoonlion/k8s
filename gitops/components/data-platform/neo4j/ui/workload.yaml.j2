apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata: {name: neo4j-internal, namespace: {{ data_namespace }}}
spec:
  serverName: neo4j.{{ data_namespace }}.svc.cluster.local
  rootCAsSecrets: [neo4j-upstream-ca]
  insecureSkipVerify: false
  forwardingTimeouts: {dialTimeout: 10s, responseHeaderTimeout: 60s}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: neo4j-ui
  namespace: {{ data_namespace }}
  annotations: {kubernetes.io/ingress.class: sunmoon}
spec:
  entryPoints: [websecure]
  routes:
    - kind: Rule
      match: 'Host(`{{ neo4j_ui_origin | urlsplit("hostname") }}`)'
      # 不透传 Host：Traefik 对后端的 SNI 是集群内名字，而透传的 Host 是公网名字，Neo4j 的 Jetty 核 SNI 与 Host 不一致就回 400 Invalid SNI（2026-10-06 第 27 轮）
      services: [{name: neo4j, port: https, scheme: https, serversTransport: neo4j-internal, passHostHeader: false}]
  tls: {secretName: neo4j-ui-tls}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: neo4j-ui-access, namespace: {{ data_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: neo4j}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: '{{ ingress_namespace }}'}}
          podSelector: {matchLabels: {app.kubernetes.io/name: traefik}}
      ports: [{protocol: TCP, port: {{ neo4j_https_port }}}]
