apiVersion: v1
kind: ConfigMap
metadata: {name: knowledge-source-policy-{{ cfg.knowledge_provider.job_revision }}, namespace: {{ data_namespace }}}
data:
  policy.json: |
    {{ {"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["s3:GetObject","s3:GetObjectVersion"],"Resource":["arn:aws:s3:::" + cfg.knowledge_provider.source_bucket + "/" + cfg.knowledge_provider.source_prefix + "*"]}]} | to_json }}
---
apiVersion: batch/v1
kind: Job
metadata: {name: knowledge-source-{{ cfg.knowledge_provider.job_revision }}, namespace: {{ data_namespace }}}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels: {app.kubernetes.io/name: knowledge-source-provision, sunmoonai.com/object-storage-client: 'true'}
    spec:
      restartPolicy: Never
      serviceAccountName: platform-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1001, runAsGroup: 1001, fsGroup: 1001, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: provision
          image: {{ registry_address }}/platform/aistor-mc@{{ image_map['aistor-mc'].manifest_digest }}
          command: [/bin/sh, -ec]
          args:
            - |
              umask 0077
              mkdir -p /work/client/certs/CAs
              cp /run/auth/config.json /work/client/config.json
              cp /run/auth/ca.crt /work/client/certs/CAs/platform.crt
              mc() {
                /usr/bin/mc --config-dir /work/client --json "$@" >/work/result.json 2>/work/error.log || return 1
                case "$(cat /work/result.json)" in
                  *'"status": "error"'*|*'"status":"error"'*) return 1 ;;
                esac
              }
              if ! mc admin user info owned '{{ cfg.knowledge_provider.source_user }}'; then
                { cat /run/auth/user; printf '\n'; cat /run/auth/password; printf '\n'; } | mc admin user add owned
              fi
              mc stat 'owned/{{ cfg.knowledge_provider.source_bucket }}'
              mc admin policy create owned knowledge-source-read /run/policy/policy.json
              mc admin policy attach owned knowledge-source-read --user '{{ cfg.knowledge_provider.source_user }}'
              if mc admin info reader; then exit 1; fi
              case "$(cat /work/result.json /work/error.log)" in
                *AccessDenied*|*'Access Denied'*) : ;;
                *) printf 'Reader rejection was not AccessDenied\n' >&2; exit 1 ;;
              esac
              printf '{"reader":"{{ cfg.knowledge_provider.source_user }}","source":"{{ cfg.knowledge_provider.source_bucket }}/{{ cfg.knowledge_provider.source_prefix }}","read_only_policy":true,"management_denied":true}\n'
          env: [{name: HOME, value: /work}, {name: NO_PROXY, value: '*'}]
          resources: {requests: {cpu: 20m, memory: 64Mi}, limits: {cpu: 500m, memory: 256Mi}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: auth, mountPath: /run/auth, readOnly: true}
            - {name: policy, mountPath: /run/policy, readOnly: true}
            - {name: work, mountPath: /work}
      volumes:
        - {name: auth, secret: {secretName: knowledge-source-provision, defaultMode: 0440}}
        - {name: policy, configMap: {name: knowledge-source-policy-{{ cfg.knowledge_provider.job_revision }}}}
        - {name: work, emptyDir: {sizeLimit: 16Mi}}
